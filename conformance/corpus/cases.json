{
  "version": 1,
  "cases": [
    {
      "id": "put-get-roundtrip",
      "operation": "putGetRoundTrip",
      "bucket": "contract-roundtrip",
      "key": "hello.txt",
      "body": "hello conformance",
      "contentType": "text/plain",
      "metadata": {
        "origin": "test"
      },
      "expect": {
        "status": 200,
        "body": "hello conformance",
        "contentType": "text/plain",
        "metadata": {
          "origin": "test"
        }
      }
    },
    {
      "id": "opaque-key-roundtrip",
      "operation": "putGetRoundTrip",
      "bucket": "contract-opaque",
      "key": "dir/../name.txt",
      "body": "opaque key",
      "contentType": "text/plain",
      "metadata": {
        "case": "opaque"
      },
      "expect": {
        "status": 200,
        "body": "opaque key",
        "contentType": "text/plain",
        "metadata": {
          "case": "opaque"
        }
      }
    },
    {
