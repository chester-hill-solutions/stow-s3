    {
      "id": "list-prefix-pagination-url-encoding",
      "operation": "listObjectsV2",
      "bucket": "contract-list-prefix",
      "prefix": "a/",
      "maxKeys": 2,
      "encodingType": "url",
      "setup": [
        {
          "key": "a/1",
          "body": "a/1"
        },
        {
          "key": "a/./two",
          "body": "opaque list key"
        },
        {
          "key": "a/3",
          "body": "a/3"
        }
      ],
      "expect": {
        "status": 200,
        "pages": [
          {
            "contents": [
              "a/./two",
              "a/1"
            ],
            "keyCount": 2,
            "isTruncated": true
          },
          {
            "contents": [
              "a/3"
            ],
            "keyCount": 1,
            "isTruncated": false
          }
        ]
      }
    },
    {
      "id": "list-delimiter-pagination",
      "operation": "listObjectsV2",
      "bucket": "contract-list-delimiter",
      "delimiter": "/",
      "maxKeys": 2,
      "setup": [
        {
          "key": "root.txt",
          "body": "root"
        },
        {
          "key": "a/1",
          "body": "a/1"
        },
        {
          "key": "a/2",
          "body": "a/2"
        },
        {
          "key": "b/1",
          "body": "b/1"
        }
      ],
      "expect": {
        "status": 200,
        "pages": [
          {
            "contents": [],
            "commonPrefixes": [
              "a/",
              "b/"
            ],
            "keyCount": 2,
            "isTruncated": true
          },
          {
            "contents": [
              "root.txt"
            ],
            "commonPrefixes": [],
            "keyCount": 1,
            "isTruncated": false
          }
        ]
      }
    },
    {
