{
  "phase": "v0.3.2-release-final-preparation",
  "sources": [
    "internal/version/version.go",
    "scripts/check-doc-links.mjs",
    "scripts/check-doc-links.test.mjs",
    "docs/releases/v0.3.2.md"
  ],
  "steps": [
    {
      "name": "set-small-buffer",
      "args": [
        "node",
        "-e",
        "const fs=require('node:fs'),p='scripts/check-doc-links.mjs';fs.copyFileSync(p,'benchmark/fixed-doc-links.mjs.txt');fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace('maxBuffer: 16 * 1024 * 1024','maxBuffer: 1024 * 1024'))"
      ]
    },
    {
      "name": "large-inventory-red",
      "args": [
        "node",
        "--test",
        "scripts/check-doc-links.test.mjs"
      ],
      "expected": 1
    },
    {
      "name": "restore-buffer-fix",
      "args": [
        "cp",
        "benchmark/fixed-doc-links.mjs.txt",
        "scripts/check-doc-links.mjs"
      ]
    },
    {
      "name": "large-inventory-green",
      "args": [
        "node",
        "--test",
        "scripts/check-doc-links.test.mjs"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    },
    {
      "name": "release-build-gates",
      "args": [
        "make",
        "build",
        "format-check",
        "check-version",
        "check-install-surface",
        "check-site-claims",
        "check-doc-commands"
      ]
    },
    {
      "name": "generated",
      "args": [
        "make",
        "check-generated"
      ]
    },
    {
      "name": "release-plan",
      "args": [
        "node",
        "scripts/release-plan.mjs"
      ],
      "env": {
        "RELEASE_VERSION": "v0.3.2"
      }
    },
    {
      "name": "source-receipt",
      "args": [
        "node",
        "-e",
        "const fs=require('node:fs'),crypto=require('node:crypto');const input=JSON.parse(fs.readFileSync('benchmark/validation-input-manifest.json'));const rows={};for(const p of Object.keys(input)){const b=fs.readFileSync(p);rows[p]=crypto.createHash('sha256').update(b).digest('hex')}fs.writeFileSync(process.env.STOW_RESULT_ROOT+'/qualified-source.json',JSON.stringify(rows,null,2))"
      ]
    }
  ]
}
