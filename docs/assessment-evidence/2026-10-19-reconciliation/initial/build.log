# Match the release build exactly, so a local binary is the binary that ships.
GOTOOLCHAIN=go1.25.6 go build -trimpath -ldflags "-s -w" -o bin/stow-s3 ./cmd/stow-s3
mkdir -p bin
GOTOOLCHAIN=go1.25.6 GOOS=js GOARCH=wasm go build -buildvcs=false -trimpath -ldflags "-s -w" -o bin/stow-runtime.wasm ./cmd/stow-wasm
