[
  [
    "focused-normal",
    [
      "go",
      "test",
      "./internal/storage/workspace",
      "-run",
      "^(TestMultipartPart|TestPartRecord|TestMultipartCompletionVerifiesRecordedPayload)",
      "-count=2",
      "-v"
    ]
  ],
  [
    "focused-race",
    [
      "go",
      "test",
      "-race",
      "./internal/storage/workspace",
      "-run",
      "^(TestMultipartPart|TestPartRecord|TestMultipartCompletionVerifiesRecordedPayload)",
      "-count=2",
      "-v"
    ]
  ],
  [
    "full-go",
    [
      "go",
      "test",
      "./..."
    ]
  ],
  [
    "broad-race",
    [
      "go",
      "test",
      "-race",
      "./internal/storage/...",
      "./internal/runtime",
      "./internal/embedded",
      "./internal/runthrough",
      "./internal/s3api",
      "./pkg/stow"
    ]
  ],
  [
    "conformance-memory",
    [
      "go",
      "test",
      "./conformance/...",
      "-count=1",
      "-v"
    ],
    {
      "STOW_CONFORMANCE_BACKEND": "memory"
    }
  ],
  [
    "conformance-filesystem",
    [
      "go",
      "test",
      "./conformance/...",
      "-count=1",
      "-v"
    ],
    {
      "STOW_CONFORMANCE_BACKEND": "filesystem"
    }
  ],
  [
    "conformance-runtime-memory",
    [
      "go",
      "test",
      "./conformance/...",
      "-count=1",
      "-v"
    ],
    {
      "STOW_CONFORMANCE_BACKEND": "runtime",
      "STOW_CONFORMANCE_RUNTIME_BACKEND": "memory"
    }
  ],
  [
    "conformance-runtime-filesystem",
    [
      "go",
      "test",
      "./conformance/...",
      "-count=1",
      "-v"
    ],
    {
      "STOW_CONFORMANCE_BACKEND": "runtime",
      "STOW_CONFORMANCE_RUNTIME_BACKEND": "filesystem"
    }
  ],
  [
    "vet",
    [
      "go",
      "vet",
      "./..."
    ]
  ],
  [
    "quality",
    [
      "make",
      "check-go-quality",
      "check-file-size",
      "format-check"
    ]
  ],
  [
    "site-build",
    [
      "npm",
      "run",
      "build",
      "--prefix",
      "site"
    ]
  ],
  [
    "site-tests",
    [
      "npm",
      "test",
      "--prefix",
      "site"
    ]
  ],
  [
    "doc-links",
    [
      "node",
      "scripts/check-doc-links.mjs"
    ]
  ]
]
