{
  "phase": "oversize-cache-bypass-final",
  "sources": [
    "internal/runthrough/adapter.go",
    "internal/runthrough/cache_read.go",
    "internal/runthrough/refresh_eviction_test.go",
    "internal/runthrough/refresh_version_fixture_test.go",
    "internal/runthrough/refresh_version_test.go",
    "internal/runthrough/refresh_version_bench_test.go",
    "internal/runthrough/cache_policy_test.go",
    "scripts/baselines/go-quality.json",
    "internal/runthrough/provenance_integrity_test.go",
    "docs/run-through.md"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/runthrough/adapter.go",
        "internal/runthrough/cache_read.go",
        "internal/runthrough/refresh_eviction_test.go",
        "internal/runthrough/refresh_version_fixture_test.go",
        "internal/runthrough/refresh_version_test.go",
        "internal/runthrough/refresh_version_bench_test.go",
        "internal/runthrough/cache_policy_test.go",
        "internal/runthrough/provenance_integrity_test.go"
      ]
    },
    {
      "name": "focused-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^(TestRefresh|TestRunthrough|TestAdapter|TestCache|TestLimitedCache|TestProvenance)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "focused-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^(TestRefresh|TestRunthrough|TestAdapter|TestCache|TestLimitedCache|TestProvenance)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "full-go",
      "args": [
        "go",
        "test",
        "./..."
      ]
    },
    {
      "name": "broad-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/...",
        "./internal/runtime",
        "./internal/embedded",
        "./internal/runthrough",
        "./internal/s3api",
        "./pkg/stow"
      ]
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./..."
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    }
  ]
}
