    "internal/storage/fs/fs_records.go",
    "internal/storage/fs/fs_atomic.go",
    "internal/storage/fs/capacity.go",
    "internal/storage/fs/completion_buffer_test.go",
    "internal/storage/fs/completion_buffer_verify_test.go",
    "internal/storage/fs/completion_capacity_version_test.go",
    "benchmark/baseline-fs_multipart.go.txt",
    "benchmark/baseline-fs_records.go.txt",
    "benchmark/baseline-fs_atomic.go.txt",
    "benchmark/baseline-capacity.go.txt",
    "benchmark/before-overlay.json",
    "benchmark/completion-probe.go.txt",
    "benchmark/measure.mjs",
    "benchmark/measure-child.py",
    "benchmark/doc-links-capture.mjs",
