{
  "phase": "bounded-correctness-closure",
  "sources": [
    "internal/storage/workspace/resolve.go",
    "internal/storage/workspace/rooted_reads.go",
    "internal/storage/workspace/objects.go",
    "internal/storage/preconditions.go",
    "internal/auth/sigv4.go",
    "internal/auth/sigv4_canonical.go",
    "internal/policystore/store.go",
    "internal/runthrough/writepolicy.go",
    "internal/storage/workspace/recovery_holds.go",
    "benchmark/workspace_probe.go.txt",
    "benchmark/auth_sdk_probe.go.txt",
    "benchmark/auth_query_probe.go.txt",
    "benchmark/etag_probe.go.txt",
    "benchmark/doc-links-capture.mjs",
    "benchmark/node-sdk-sign.mjs"
  ],
  "steps": [
    {
      "name": "closed-normal",
      "args": [
        "go",
        "test",
        "./internal/policystore",
        "./internal/storage/workspace",
        "./internal/runthrough",
        "./internal/storage/fs",
        "./internal/auth",
        "-run",
        "^(TestAPolicyWiderThanTheEnvironmentIsRefusedOnRead|TestAnExpiredRecoveryHoldStopsBlocking|TestEffectiveWritePolicy.*|TestStartupBannerReflectsEffectiveWritePolicy|TestCapacityFenceFailureRetainsReservation|TestCapacityWriteFailureBeforeRenameCanReconcile|TestMalformedSignedHeadersAreRefused|TestRepeatedAuthorizationComponentsAreRefused|TestOrdinaryRepeatedQueryParametersStillCanonicalize)$",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "closed-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/policystore",
        "./internal/storage/workspace",
        "./internal/runthrough",
        "./internal/storage/fs",
        "./internal/auth",
        "-run",
        "^(TestAPolicyWiderThanTheEnvironmentIsRefusedOnRead|TestAnExpiredRecoveryHoldStopsBlocking|TestEffectiveWritePolicy.*|TestStartupBannerReflectsEffectiveWritePolicy|TestCapacityFenceFailureRetainsReservation|TestCapacityWriteFailureBeforeRenameCanReconcile|TestMalformedSignedHeadersAreRefused|TestRepeatedAuthorizationComponentsAreRefused|TestOrdinaryRepeatedQueryParametersStillCanonicalize)$",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "node-sdk-install",
      "args": [
        "npm",
        "ci",
        "--ignore-scripts",
        "--omit=dev",
        "--omit=optional",
        "--prefix",
        "packages/stow-s3"
      ]
    },
    {
      "name": "node-sdk-sign",
      "args": [
        "node",
        "benchmark/node-sdk-sign.mjs"
      ]
    },
    {
      "name": "install-workspace_probe",
      "args": [
        "cp",
        "benchmark/workspace_probe.go.txt",
        "internal/storage/workspace/closure_probe_test.go"
      ]
    },
    {
      "name": "install-auth_sdk_probe",
      "args": [
        "cp",
        "benchmark/auth_sdk_probe.go.txt",
        "internal/auth/closure_sdk_probe_test.go"
      ]
    },
    {
      "name": "install-auth_query_probe",
      "args": [
        "cp",
        "benchmark/auth_query_probe.go.txt",
        "internal/auth/closure_query_probe_test.go"
      ]
    },
    {
      "name": "install-etag_probe",
      "args": [
        "cp",
        "benchmark/etag_probe.go.txt",
        "internal/s3api/closure_etag_probe_test.go"
      ]
    },
    {
      "name": "format-probes",
      "args": [
        "gofmt",
        "-w",
        "internal/storage/workspace/closure_probe_test.go",
        "internal/auth/closure_sdk_probe_test.go",
        "internal/auth/closure_query_probe_test.go",
        "internal/s3api/closure_etag_probe_test.go"
      ]
    },
    {
      "name": "capture-probes",
      "args": [
        "node",
        "-e",
        "const fs=require('node:fs'),p={\"workspace_probe\": \"internal/storage/workspace/closure_probe_test.go\", \"auth_sdk_probe\": \"internal/auth/closure_sdk_probe_test.go\", \"auth_query_probe\": \"internal/auth/closure_query_probe_test.go\", \"etag_probe\": \"internal/s3api/closure_etag_probe_test.go\"};for(const[n,f]of Object.entries(p))fs.copyFileSync(f,process.env.STOW_RESULT_ROOT+'/'+n+'.formatted.go.txt');fs.copyFileSync('/go/pkg/mod/github.com/aws/aws-sdk-go-v2@v1.47.2/aws/signer/v4/v4.go',process.env.STOW_RESULT_ROOT+'/sdk-v4.go.txt')"
      ]
    },
    {
      "name": "workspace-normal",
      "args": [
        "go",
        "test",
        "./internal/storage/workspace",
        "-run",
        "^TestClosureWorkspaceUnreadable$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "workspace-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/workspace",
        "-run",
        "^TestClosureWorkspaceUnreadable$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "auth-normal",
      "args": [
        "go",
        "test",
        "./internal/auth",
        "-run",
        "^TestClosure",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "auth-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/auth",
        "-run",
        "^TestClosure",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "s3api-normal",
      "args": [
        "go",
        "test",
        "./internal/s3api",
        "-run",
        "^TestClosureETagCase$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "s3api-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/s3api",
        "-run",
        "^TestClosureETagCase$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "cleanup-probes",
      "args": [
        "rm",
        "internal/storage/workspace/closure_probe_test.go",
        "internal/auth/closure_sdk_probe_test.go",
        "internal/auth/closure_query_probe_test.go",
        "internal/s3api/closure_etag_probe_test.go"
      ]
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./internal/auth",
        "./internal/storage/workspace",
        "./internal/storage/fs",
        "./internal/policystore",
        "./internal/runthrough",
        "./internal/s3api"
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "--import",
        "./benchmark/doc-links-capture.mjs",
        "scripts/check-doc-links.mjs"
      ]
    }
  ]
}
