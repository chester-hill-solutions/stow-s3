{
  "phase": "ledger-digest-prototype",
  "sources": [
    "internal/capacity/state.go",
    "internal/capacity/state_digest_test.go",
    "benchmark/stream-state.go.txt",
    "benchmark/isolate-bench.go.txt",
    "benchmark/digest-measure.mjs",
    "benchmark/measure-child.py",
    "benchmark/stream-overlay.json"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/capacity/state_digest_test.go",
        "benchmark/stream-state.go.txt"
      ]
    },
    {
      "name": "red-normal",
      "args": [
        "go",
        "test",
        "./internal/capacity",
        "-run",
        "^TestStateDigest",
        "-count=1",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "red-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/capacity",
        "-run",
        "^TestStateDigest",
        "-count=1",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "prototype-normal",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/stream-overlay.json",
        "./internal/capacity",
        "-run",
        "^TestStateDigest",
        "-count=1",
        "-v"
      ]
    },
    {
      "name": "prototype-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/stream-overlay.json",
        "./internal/capacity",
        "-run",
        "^TestStateDigest",
        "-count=1",
        "-v"
      ]
    },
    {
      "name": "install-benchmark",
      "args": [
        "cp",
        "benchmark/isolate-bench.go.txt",
        "internal/capacity/ledger_isolate_bench_test.go"
      ]
    },
    {
      "name": "format-benchmark",
      "args": [
        "gofmt",
        "-w",
        "internal/capacity/ledger_isolate_bench_test.go"
      ]
    },
    {
      "name": "build-before",
      "args": [
        "go",
        "test",
        "-c",
        "-o",
        "benchmark/digest-before.test",
        "./internal/capacity"
      ]
    },
    {
      "name": "build-after",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/stream-overlay.json",
        "-c",
        "-o",
        "benchmark/digest-after.test",
        "./internal/capacity"
      ]
    },
    {
      "name": "measure",
      "args": [
        "node",
        "benchmark/digest-measure.mjs"
      ]
    },
    {
      "name": "remove-benchmark",
      "args": [
        "rm",
        "internal/capacity/ledger_isolate_bench_test.go"
      ]
    }
  ]
}
