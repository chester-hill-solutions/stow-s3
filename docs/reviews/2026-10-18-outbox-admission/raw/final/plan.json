{
  "phase": "outbox-admission-final",
  "sources": [
    "internal/runthrough/outbox.go",
    "internal/runthrough/file_outbox.go",
    "internal/runthrough/outbox_admission_test.go",
    "internal/runthrough/outbox_admission_bench_test.go",
    "internal/runthrough/file_outbox_snapshot_test.go",
    "internal/runthrough/outbox_admission_sequence_test.go"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/runthrough/outbox.go",
        "internal/runthrough/file_outbox.go",
        "internal/runthrough/outbox_admission_test.go",
        "internal/runthrough/outbox_admission_bench_test.go",
        "internal/runthrough/file_outbox_snapshot_test.go",
        "internal/runthrough/outbox_admission_sequence_test.go"
      ]
    },
    {
      "name": "focused-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^(TestFileOutbox|TestOutbox)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "focused-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^(TestFileOutbox|TestOutbox)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "full-go",
      "args": [
        "go",
        "test",
        "./...",
        "-count=1"
      ]
    },
    {
      "name": "broad-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/...",
        "./internal/runtime",
        "./internal/embedded",
        "./internal/runthrough",
        "./internal/s3api",
        "./pkg/stow",
        "-count=1"
      ]
    },
    {
      "name": "conformance-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "filesystem"
      }
    },
    {
      "name": "conformance-runtime-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-runtime-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "filesystem"
      }
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./..."
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "baseline-benchmark-build",
      "args": [
        "go",
        "test",
        "-c",
        "-overlay",
        "benchmark/admission-baseline-overlay.json",
        "./internal/runthrough",
        "-o",
        "benchmark/outbox-admission-before.test"
      ]
    },
    {
      "name": "benchmark-build",
      "args": [
        "go",
        "test",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/outbox-admission-after.test"
      ]
    },
    {
      "name": "comparison",
      "args": [
        "node",
        "benchmark/admission-comparison.mjs"
      ]
    }
  ]
}
