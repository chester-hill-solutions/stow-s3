      "expected": 1
    },
    {
      "name": "baseline-counter-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay",
        "benchmark/admission-baseline-overlay.json",
        "./internal/runthrough",
        "-run",
        "^TestOutboxAdmissionRejectsExhaustedSequence$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "candidate-counter-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^TestOutboxAdmissionRejectsExhaustedSequence$",
        "-count=2",
        "-v"
      ],
      "expected": 0
    },
    {
      "name": "candidate-counter-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^TestOutboxAdmissionRejectsExhaustedSequence$",
        "-count=2",
        "-v"
      ],
      "expected": 0
