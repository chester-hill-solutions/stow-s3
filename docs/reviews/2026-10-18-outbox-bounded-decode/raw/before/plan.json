{
  "phase": "outbox-decode-before",
  "sources": [
    "internal/runthrough/file_outbox_proto.go",
    "internal/runthrough/outbox_decode_resource_test.go",
    "benchmark/decode-profile-bench.go.txt",
    "benchmark/decode-profile.json",
    "benchmark/decode-profiles.mjs"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/runthrough/outbox_decode_resource_test.go",
        "benchmark/decode-profile-bench.go.txt"
      ]
    },
    {
      "name": "resource-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^TestOutboxDecodeRejectsDuplicateFloodWithinBudget$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "resource-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^TestOutboxDecodeRejectsDuplicateFloodWithinBudget$",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/decode-profile.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/decode-before.test"
      ]
    },
    {
      "name": "profiles",
      "args": [
        "node",
        "benchmark/decode-profiles.mjs"
      ]
    }
  ]
}
