        "-count=2",
        "-v"
      ]
    },
    {
      "name": "candidate-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/decode-candidate.json",
        "./internal/runthrough",
        "-run",
        "^(TestOutboxDecode|TestFileOutboxDuplicateFlood)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "before-build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/decode-before-measure.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/decode-before.test"
      ]
    },
    {
      "name": "candidate-build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/decode-candidate-measure.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/decode-candidate.test"
      ]
    },
    {
      "name": "confirmation",
      "args": [
        "node",
        "benchmark/decode-confirmation.mjs"
      ]
    }
  ]
