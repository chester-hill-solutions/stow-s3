{
  "phase": "outbox-decode-confirmation",
  "sources": [
    "internal/runthrough/file_outbox_proto.go",
    "internal/runthrough/outbox_decode_resource_test.go",
    "internal/runthrough/outbox_decode_reference_test.go",
    "internal/runthrough/outbox_decode_equivalence_test.go",
    "benchmark/candidate-file_outbox_proto.go.txt",
    "benchmark/candidate-file_outbox_proto_decode.go.txt",
    "benchmark/decode-candidate.json",
