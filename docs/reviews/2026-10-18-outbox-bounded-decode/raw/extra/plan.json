    "benchmark/decode-confirmation.mjs"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "benchmark/candidate-file_outbox_proto_decode.go.txt"
      ]
    },
    {
      "name": "candidate-normal",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/decode-candidate.json",
