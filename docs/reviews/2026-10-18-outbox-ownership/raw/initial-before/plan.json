    "internal/runthrough/outbox_ownership_controls_test.go"
  ],
  "steps": [
    {
      "name": "format-tests",
      "args": [
        "gofmt",
        "-w",
        "internal/runthrough/outbox_ownership_test.go",
        "internal/runthrough/outbox_ownership_controls_test.go"
      ]
    },
    {
      "name": "regression-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^TestOutboxOwnership",
