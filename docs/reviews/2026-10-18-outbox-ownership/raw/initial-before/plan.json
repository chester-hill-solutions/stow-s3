      "expected": 1
    },
    {
      "name": "regression-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^TestOutboxOwnership",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "benchmark-build",
      "args": [
        "go",
        "test",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/ownership-before.test"
      ]
    }
  ]
