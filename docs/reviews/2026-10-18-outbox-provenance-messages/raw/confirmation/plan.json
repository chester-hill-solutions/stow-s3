{
  "phase": "outbox-provenance-confirmation",
  "sources": [
    "internal/runthrough/file_outbox_proto.go",
    "internal/runthrough/outbox_proto_blocks_test.go",
    "internal/runthrough/outbox_proto_blocks_resource_test.go",
    "internal/runthrough/outbox_proto_blocks_bench_test.go",
    "benchmark/provenance-file_outbox_proto.go.txt",
    "benchmark/proto-block-provenance.json",
    "benchmark/provenance-comparison.mjs",
    "benchmark/confirmation.mjs"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "benchmark/provenance-file_outbox_proto.go.txt"
      ]
    },
    {
      "name": "provenance-normal",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/proto-block-provenance.json",
        "./internal/runthrough",
        "-run",
        "^(TestOutboxProtoBlock|TestOutboxProtoMatchesJSONState|TestOutboxProtoPreservesTimestampErrors|TestFileOutboxOwnWrite|TestFileOutboxReleasesCallerStringBuffers|TestOutboxStateClone)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "provenance-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/proto-block-provenance.json",
        "./internal/runthrough",
        "-run",
        "^(TestOutboxProtoBlock|TestOutboxProtoMatchesJSONState|TestOutboxProtoPreservesTimestampErrors|TestFileOutboxOwnWrite|TestFileOutboxReleasesCallerStringBuffers|TestOutboxStateClone)",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "before-build",
      "args": [
        "go",
        "test",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/provenance-before.test"
      ]
    },
    {
      "name": "provenance-build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/proto-block-provenance.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/provenance-after.test"
      ]
    },
    {
      "name": "comparison",
      "args": [
        "node",
        "benchmark/confirmation.mjs"
      ]
    }
  ]
}
