{
  "phase": "outbox-snapshot-final",
  "sources": [
    "internal/runthrough/file_outbox.go",
    "internal/runthrough/outbox.go",
    "internal/runthrough/file_outbox_proto_native_test.go",
    "internal/runthrough/file_outbox_snapshot_test.go",
    "internal/runthrough/file_outbox_snapshot_bench_test.go",
    "internal/runthrough/file_outbox_snapshot_writer_bench_test.go"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/runthrough/file_outbox.go",
        "internal/runthrough/outbox.go",
        "internal/runthrough/file_outbox_proto_native_test.go",
        "internal/runthrough/file_outbox_snapshot_test.go",
        "internal/runthrough/file_outbox_snapshot_bench_test.go",
        "internal/runthrough/file_outbox_snapshot_writer_bench_test.go"
      ]
    },
    {
      "name": "focused-normal",
      "args": [
        "go",
        "test",
        "./internal/runthrough",
        "-run",
        "^TestFileOutbox",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "focused-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/runthrough",
        "-run",
        "^TestFileOutbox",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "full-go",
      "args": [
        "go",
        "test",
        "./...",
        "-count=1"
      ]
    },
    {
      "name": "broad-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/...",
        "./internal/runtime",
        "./internal/embedded",
        "./internal/runthrough",
        "./internal/s3api",
        "./pkg/stow",
        "-count=1"
      ]
    },
    {
      "name": "conformance-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "filesystem"
      }
    },
    {
      "name": "conformance-runtime-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-runtime-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "filesystem"
      }
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./..."
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "comparison",
      "args": [
        "node",
        "benchmark/compare.mjs"
      ]
    }
  ],
  "compare": {
    "fixtures": [
      "empty",
      "small",
      "provenance=16384",
      "provenance=65536",
      "provenance=262144",
      "active=16384",
      "prepared=16384",
      "mixed=2048"
    ],
    "stages": [
      "pending",
      "prepared"
    ],
    "cpu": [
      1,
      4
    ],
    "cycles": 2,
    "benchtime": "500ms",
    "contracts": false,
    "fixed": true,
    "writers": true
  }
}
