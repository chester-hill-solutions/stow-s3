{
  "phase": "outbox-snapshot-pilot",
  "sources": [
    "internal/runthrough/file_outbox.go",
    "internal/runthrough/outbox.go",
    "internal/runthrough/file_outbox_proto_native_test.go",
    "internal/runthrough/file_outbox_snapshot_test.go",
