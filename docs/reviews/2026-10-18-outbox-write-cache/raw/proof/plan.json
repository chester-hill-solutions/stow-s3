{
  "phase": "outbox-write-cache-proof",
  "sources": [
    "internal/runthrough/file_outbox.go",
    "internal/runthrough/file_outbox_proto.go",
    "benchmark/write-cache/contract_test.go.txt",
    "benchmark/write-cache/bench_test.go.txt",
    "benchmark/write-cache/naive-file_outbox.go.txt",
    "benchmark/write-cache/safe-file_outbox.go.txt",
    "benchmark/write-cache/safe-file_outbox_proto.go.txt",
    "benchmark/write-cache-before.json",
    "benchmark/write-cache-naive.json",
    "benchmark/write-cache-safe.json",
    "benchmark/cache-comparison.mjs"
  ],
  "steps": [
    {
      "name": "format-probes",
      "args": [
        "gofmt",
        "-w",
        "benchmark/write-cache/contract_test.go.txt",
        "benchmark/write-cache/bench_test.go.txt",
        "benchmark/write-cache/naive-file_outbox.go.txt",
        "benchmark/write-cache/safe-file_outbox.go.txt",
        "benchmark/write-cache/safe-file_outbox_proto.go.txt"
      ]
    },
    {
      "name": "before-contracts",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/write-cache-before.json",
        "./internal/runthrough",
        "-run",
        "^TestFileOutboxOwnWrite",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "before-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/write-cache-before.json",
        "./internal/runthrough",
        "-run",
        "^TestFileOutboxOwnWrite",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "naive-counterexamples",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/write-cache-naive.json",
        "./internal/runthrough",
        "-run",
        "^TestFileOutboxOwnWrite",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "safe-contracts",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/write-cache-safe.json",
        "./internal/runthrough",
        "-count=1"
      ]
    },
    {
      "name": "safe-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/write-cache-safe.json",
        "./internal/runthrough",
        "-count=1"
      ]
    },
    {
      "name": "before-build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/write-cache-before.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/write-cache-before.test"
      ]
    },
    {
      "name": "safe-build",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/write-cache-safe.json",
        "-c",
        "./internal/runthrough",
        "-o",
        "benchmark/write-cache-safe.test"
      ]
    },
    {
      "name": "comparison",
      "args": [
        "node",
        "benchmark/cache-comparison.mjs"
      ]
    }
  ]
}
