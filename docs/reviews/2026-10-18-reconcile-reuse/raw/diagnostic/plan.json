{
  "phase": "reconcile-reuse-same-binary-diagnostic",
  "sources": [
    "internal/capacity/state.go",
    "internal/capacity/admission.go",
    "benchmark/diagnostic-admission.go.txt",
    "benchmark/diagnostic-overlay.json",
    "benchmark/reuse-trace.go.txt",
    "benchmark/toggle-measure.mjs"
  ],
  "steps": [
    {
      "name": "install-capacity-benchmark",
      "args": [
        "cp",
        "benchmark/ledger-reuse-bench.go.txt",
        "internal/capacity/ledger_reuse_bench_test.go"
      ]
    },
    {
      "name": "install-mutation-benchmark",
      "args": [
        "cp",
        "benchmark/mutation-reuse-bench.go.txt",
        "internal/storage/fs/ledger_reuse_bench_test.go"
      ]
    },
    {
      "name": "install-trace",
      "args": [
        "cp",
        "benchmark/reuse-trace.go.txt",
        "internal/storage/fs/reuse_trace_test.go"
      ]
    },
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "benchmark/diagnostic-admission.go.txt",
        "internal/capacity/ledger_reuse_bench_test.go",
        "internal/storage/fs/ledger_reuse_bench_test.go",
        "internal/storage/fs/reuse_trace_test.go"
      ]
    },
    {
      "name": "trace",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/diagnostic-overlay.json",
        "./internal/storage/fs",
        "-run",
        "^TestReconcileEligibilityTrace$",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_REUSE_DIAGNOSTIC": "on",
        "STOW_REUSE_TRACE": "1"
      }
    },
    {
      "name": "build-capacity",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/diagnostic-overlay.json",
        "-c",
        "-o",
        "benchmark/capacity-toggle.test",
        "./internal/capacity"
      ]
    },
    {
      "name": "build-fs",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/diagnostic-overlay.json",
        "-c",
        "-o",
        "benchmark/fs-toggle.test",
        "./internal/storage/fs"
      ]
    },
    {
      "name": "measure",
      "args": [
        "node",
        "benchmark/toggle-measure.mjs"
      ]
    },
    {
      "name": "cleanup",
      "args": [
        "rm",
        "internal/capacity/ledger_reuse_bench_test.go",
        "internal/storage/fs/ledger_reuse_bench_test.go",
        "internal/storage/fs/reuse_trace_test.go"
      ]
    }
  ]
}
