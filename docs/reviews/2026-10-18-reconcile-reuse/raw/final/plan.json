{
  "phase": "reconcile-reuse-final",
  "sources": [
    "internal/capacity/state.go",
    "internal/capacity/admission.go",
    "internal/capacity/reconcile_unchanged_test.go",
    "benchmark/baseline-state.go.txt",
    "benchmark/baseline-admission.go.txt",
    "benchmark/before-overlay.json",
    "benchmark/ledger-reuse-bench.go.txt",
    "benchmark/mutation-reuse-bench.go.txt",
    "benchmark/reuse-measure.mjs",
    "benchmark/measure-child.py"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/capacity/state.go",
        "internal/capacity/admission.go",
        "internal/capacity/reconcile_unchanged_test.go"
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "verified-red-normal",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/before-overlay.json",
        "./internal/capacity",
        "-run",
        "^TestReconcileUnchanged",
        "-count=1",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "verified-red-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/before-overlay.json",
        "./internal/capacity",
        "-run",
        "^TestReconcileUnchanged",
        "-count=1",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "focused-normal",
      "args": [
        "go",
        "test",
        "./internal/storage/fs",
        "./internal/capacity",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "focused-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/fs",
        "./internal/capacity",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "full-go",
      "args": [
        "go",
        "test",
        "./...",
        "-count=1"
      ]
    },
    {
      "name": "broad-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/capacity",
        "./internal/storage/...",
        "./internal/runtime",
        "./internal/embedded",
        "./internal/runthrough",
        "./internal/s3api",
        "./pkg/stow",
        "-count=1"
      ]
    },
    {
      "name": "conformance-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "filesystem"
      }
    },
    {
      "name": "conformance-runtime-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-runtime-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "filesystem"
      }
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./..."
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    },
    {
      "name": "install-capacity-benchmark",
      "args": [
        "cp",
        "benchmark/ledger-reuse-bench.go.txt",
        "internal/capacity/ledger_reuse_bench_test.go"
      ]
    },
    {
      "name": "install-mutation-benchmark",
      "args": [
        "cp",
        "benchmark/mutation-reuse-bench.go.txt",
        "internal/storage/fs/ledger_reuse_bench_test.go"
      ]
    },
    {
      "name": "format-benchmarks",
      "args": [
        "gofmt",
        "-w",
        "internal/capacity/ledger_reuse_bench_test.go",
        "internal/storage/fs/ledger_reuse_bench_test.go"
      ]
    },
    {
      "name": "snapshot-benchmarks",
      "args": [
        "node",
        "-e",
        "const fs=require('node:fs');for(const[p,n]of [['capacity','internal/capacity/ledger_reuse_bench_test.go'],['fs','internal/storage/fs/ledger_reuse_bench_test.go']])fs.copyFileSync(n,process.env.STOW_RESULT_ROOT+'/compiled-'+p+'-bench.go.txt')"
      ]
    },
    {
      "name": "build-capacity-before",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/before-overlay.json",
        "-c",
        "-o",
        "benchmark/capacity-before.test",
        "./internal/capacity"
      ]
    },
    {
      "name": "build-capacity-after",
      "args": [
        "go",
        "test",
        "-c",
        "-o",
        "benchmark/capacity-after.test",
        "./internal/capacity"
      ]
    },
    {
      "name": "build-fs-before",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/before-overlay.json",
        "-c",
        "-o",
        "benchmark/fs-before.test",
        "./internal/storage/fs"
      ]
    },
    {
      "name": "build-fs-after",
      "args": [
        "go",
        "test",
        "-c",
        "-o",
        "benchmark/fs-after.test",
        "./internal/storage/fs"
      ]
    },
    {
      "name": "measure",
      "args": [
        "node",
        "benchmark/reuse-measure.mjs"
      ]
    },
    {
      "name": "remove-benchmarks",
      "args": [
        "rm",
        "internal/capacity/ledger_reuse_bench_test.go",
        "internal/storage/fs/ledger_reuse_bench_test.go"
      ]
    }
  ]
}
