{
  "phase": "save-admission-final",
  "sources": [
    "internal/storage/fs/capacity_save_test.go",
    "internal/storage/fs/capacity_save_publication_test.go",
    "internal/capacity/admission_unknown_test.go",
    "internal/storage/fs/capacity_save.go",
    "internal/storage/fs/save_requests.go",
    "internal/capacity/admission.go"
  ],
  "steps": [
    {
      "name": "format",
      "args": [
        "gofmt",
        "-w",
        "internal/storage/fs/capacity_save_test.go",
        "internal/storage/fs/capacity_save_publication_test.go",
        "internal/capacity/admission_unknown_test.go",
        "internal/storage/fs/capacity_save.go",
        "internal/storage/fs/save_requests.go",
        "internal/capacity/admission.go"
      ]
    },
    {
      "name": "quality",
      "args": [
        "make",
        "check-go-quality",
        "check-file-size",
        "format-check"
      ]
    },
    {
      "name": "verified-red-normal",
      "args": [
        "go",
        "test",
        "-overlay=benchmark/before-overlay.json",
        "./internal/storage/fs",
        "./internal/capacity",
        "-run",
        "^(TestSaveCapacity|TestAdmissionRetainsUnknown)",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "verified-red-race",
      "args": [
        "go",
        "test",
        "-race",
        "-overlay=benchmark/before-overlay.json",
        "./internal/storage/fs",
        "./internal/capacity",
        "-run",
        "^(TestSaveCapacity|TestAdmissionRetainsUnknown)",
        "-count=2",
        "-v"
      ],
      "expected": 1
    },
    {
      "name": "focused-normal",
      "args": [
        "go",
        "test",
        "./internal/storage/fs",
        "./internal/capacity",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "focused-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/storage/fs",
        "./internal/capacity",
        "-count=2",
        "-v"
      ]
    },
    {
      "name": "full-go",
      "args": [
        "go",
        "test",
        "./...",
        "-count=1"
      ]
    },
    {
      "name": "broad-race",
      "args": [
        "go",
        "test",
        "-race",
        "./internal/capacity",
        "./internal/storage/...",
        "./internal/runtime",
        "./internal/embedded",
        "./internal/runthrough",
        "./internal/s3api",
        "./pkg/stow",
        "-count=1"
      ]
    },
    {
      "name": "conformance-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "filesystem"
      }
    },
    {
      "name": "conformance-runtime-memory",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "memory"
      }
    },
    {
      "name": "conformance-runtime-filesystem",
      "args": [
        "go",
        "test",
        "./conformance/...",
        "-count=1",
        "-v"
      ],
      "env": {
        "STOW_CONFORMANCE_BACKEND": "runtime",
        "STOW_CONFORMANCE_RUNTIME_BACKEND": "filesystem"
      }
    },
    {
      "name": "vet",
      "args": [
        "go",
        "vet",
        "./..."
      ]
    },
    {
      "name": "site-build",
      "args": [
        "npm",
        "run",
        "build",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "site-tests",
      "args": [
        "npm",
        "test",
        "--prefix",
        "site"
      ]
    },
    {
      "name": "doc-links",
      "args": [
        "node",
        "scripts/check-doc-links.mjs"
      ]
    }
  ]
}
