  "author": {"name": "Chester Hill Solutions"},
  "repository": "https://github.com/chester-hill-solutions/stow-s3",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Stow Storage",
        "shortDescription": "Browse your configured Stow bucket",
        "developerName": "Chester Hill Solutions",
        "category": "Productivity",
