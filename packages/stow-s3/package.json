{
  "name": "@chester-hill-solutions/stow-s3",
  "version": "0.3.3",
  "description": "TypeScript client for the stow local S3-compatible dev bucket service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./node-wasm": {
      "types": "./dist/node-wasm-host.d.ts",
      "import": "./dist/node-wasm-host.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./browser-s3": {
      "types": "./dist/browser-s3.d.ts",
      "import": "./dist/browser-s3.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./browser-wasm": {
      "types": "./dist/browser-wasm-host.d.ts",
      "import": "./dist/browser-wasm-host.js"
    },
    "./project": {
      "types": "./dist/project-library.d.ts",
      "import": "./dist/project-library.js"
    }
  },
  "bin": {
    "stow-doctor": "./bin/stow-doctor.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node scripts/copy-wasm-assets.mjs",
    "test": "npm run build && tsx --test test/integration.test.ts test/lifecycle.test.ts test/embedded.test.ts test/node-wasm-host.test.ts test/browser.test.ts test/file-history.test.ts test/browser-s3.test.ts test/ready.test.ts test/session.test.ts test/session-lifecycle.test.ts test/session-close.test.ts test/doctor.test.ts test/ownership.test.ts test/ready-framing.test.ts test/startup-options.test.ts test/wasm-assets.test.ts test/workspace.test.ts test/persistence-format.test.ts test/worker-host.test.ts test/content-store.test.ts test/project.test.ts test/content-object-host.test.ts test/host-backed-streams.test.ts test/project-migration.test.ts test/lint-config.test.ts",
    "test:browser": "npm run build && playwright test --config scripts/browser-playwright.config.mjs",
    "test:browser:railway": "node scripts/browser-railway-test.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "check:lint-ratchet": "node ../../scripts/check-lint-ratchet.mjs",
    "check:type-escapes": "node ../../scripts/check-type-escapes.mjs",
    "check:dry": "node ../../scripts/check-dry.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "check:standards": "npm run typecheck && npm run lint && npm run check:lint-ratchet && npm run check:type-escapes && npm run check:dry"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@smithy/signature-v4": "^5.7.4",
    "@smithy/types": "^4.1.0"
  },
  "optionalDependencies": {
    "@chester-hill-solutions/stow-s3-darwin-arm64": "0.3.3",
    "@chester-hill-solutions/stow-s3-darwin-x64": "0.3.3",
    "@chester-hill-solutions/stow-s3-linux-arm64": "0.3.3",
    "@chester-hill-solutions/stow-s3-linux-x64": "0.3.3"
  },
  "devDependencies": {
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "jscpd": "^5.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chester-hill-solutions/stow-s3.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
